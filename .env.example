# Copy to .env.local (gitignored) and fill in real values. Never commit this file with real secrets.

# Stable HTTPS base URL for this deployment — the Vercel production domain,
# not a preview URL (those change per-deploy and would need re-registering
# as a redirect/webhook URI in Meta every time). e.g. https://ig-spike.vercel.app
BASE_URL=

# Meta App (developers.facebook.com) — same App ID/Secret usually covers both
# products below; confirm on each product's settings page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Facebook Login for Business Configuration ID (App Dashboard → Facebook
# Login for Business → Configurations), not the App ID. A config_id is
# scoped to the specific app it was created in — it must belong to this
# same FACEBOOK_APP_ID, or Meta's OAuth dialog shows a generic "Feature
# unavailable" error. The Configuration itself needs instagram_basic,
# instagram_manage_comments, pages_show_list, pages_read_engagement selected.
FACEBOOK_LOGIN_CONFIG_ID=

# Any random string you choose; register the same value as the webhook
# verify token in the Meta app dashboard.
WEBHOOK_VERIFY_TOKEN=

# Filled in after running the auth flows (Section 1), used by the discovery
# polling/retrieval probes (Section 3.3, 3.1 mentioned_media). IMPORTANT: the
# IG user ID is NOT the same value across login products — Instagram Login
# and Facebook Login use two different ID namespaces for the same underlying
# Instagram account (discovered the hard way in SPIKE-RESULTS.md Section 3.1
# after a "does not exist" error from using the wrong one). Keep both pairs.
ORGANIZER_IG_USER_ID=
ORGANIZER_ACCESS_TOKEN=
FACEBOOK_ORGANIZER_IG_USER_ID=
FACEBOOK_ORGANIZER_ACCESS_TOKEN=

# Note: the OAuth callbacks never render raw access tokens, in any
# environment (removed as a security hardening measure — there is no env
# var that re-enables it). The four ORGANIZER_*/FACEBOOK_ORGANIZER_* vars
# above are read only by the manual diagnostic routes under
# app/api/discovery/* (unchanged, out of Slice A's scope) — the real
# /api/auth/{facebook,instagram}/start|callback connect flow no longer uses
# them at all. It now persists an encrypted access token per workspace in
# the database (see TOKEN_ENCRYPTION_KEY below) instead of a global env var.

# --- Slice A: database, auth, and token encryption -------------------------

# Neon Postgres connection string (neon.tech — create a project, copy the
# pooled connection string). Required even to run `npm run build` locally,
# since the Drizzle client is constructed at module load time.
DATABASE_URL=

# Any long random string (openssl rand -base64 32) — signs/encrypts Better
# Auth's own session cookies. Not the same key as TOKEN_ENCRYPTION_KEY below.
BETTER_AUTH_SECRET=

# AES-256-GCM key for encrypting stored Meta access tokens at rest. Generate
# with: openssl rand -base64 32. Losing/rotating this key makes every
# existing MetaConnection row undecryptable — organizers would need to
# reconnect. Never commit this value; store it only in Vercel's encrypted
# env var UI.
TOKEN_ENCRYPTION_KEY=

# Magic-link email delivery. No provider account has been created yet for
# this project — until these are set, sign-in works locally by logging the
# link to the console instead of emailing it (lib/email.ts), and fails
# loudly in production. Resend (resend.com) is a reasonable default: create
# an account, verify a sending domain, and set:
RESEND_API_KEY=
MAGIC_LINK_FROM_EMAIL=

# HMAC key for hashing client IPs before storing them in rate_limit_bucket
# (lib/rate-limit.ts). Generate with: openssl rand -base64 32. A dedicated
# secret, not shared with TOKEN_ENCRYPTION_KEY/BETTER_AUTH_SECRET — this one
# only ever protects pseudonymized abuse counters, never real user data, so
# it can be rotated independently without affecting anything else. Rotating
# it just resets everyone's rate-limit history (harmless).
RATE_LIMIT_HASH_SECRET=

# Recipient for the internal "someone signed up for early access" notification
# (app/landing/EarlyAccessSection.tsx → app/api/early-access/route.ts). Reuses
# the same RESEND_API_KEY/MAGIC_LINK_FROM_EMAIL above — only the destination
# address differs. No confirmation email is sent to the submitter.
EARLY_ACCESS_NOTIFY_EMAIL=

# Google sign-in (optional for Slice A — deferred per HANDOVER.md). Leave
# both unset to omit the Google provider entirely; set both together to
# enable it. Create credentials at console.cloud.google.com (OAuth client,
# Web application, authorized redirect URI:
# {BASE_URL}/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
